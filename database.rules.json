{
  "rules": {
    ".read": false,
    ".write": false,
    "presence": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "typing": {
      "$conversationId": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },
    "waitingUsers": {
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "activeMatches": {
      "$matchId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "voiceCalls": {
      "$callId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}
