rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'moderator'];
    }

    function isUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isGroupAdmin(groupId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.adminIds;
    }

    function isGroupMember(groupId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    function isGroupCreator(groupId) {
      return signedIn() && request.auth.uid == get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy;
    }

    function novaNameUpdateAllowed(userId) {
      return isUser(userId) && (
        request.resource.data.novaName == resource.data.novaName
        || (
          request.resource.data.novaNameChangedAt == request.time
          && (!resource.data.keys().hasAny(['novaNameChangedAt'])
            || request.time > resource.data.novaNameChangedAt + duration.value(60, 'd'))
        )
      );
    }

    function userProfileSelfUpdateAllowed(userId) {
      return isUser(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'uid',
        'username',
        'email',
        'displayName',
        'avatarUrl',
        'bio',
        'department',
        'semester',
        'country',
        'gender',
        'dob',
        'language',
        'subjects',
        'interests',
        'skills',
        'lastSeen',
        'online',
        'searchingForStudyPartner',
        'accountStatus',
        'role',
        'verificationStatus',
        'novaName',
        'novaNameChangedAt'
      ]);
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isUser(userId) && request.resource.data.keys().hasAll(['novaName', 'novaNameChangedAt']);
      allow update: if (novaNameUpdateAllowed(userId) || userProfileSelfUpdateAllowed(userId) || isAdmin());
      allow delete: if isAdmin();

      match /settings/{settingId} {
        allow read, write: if isUser(userId) || isAdmin();
      }
    }

    match /friend_requests/{requestId} {
      allow read: if signedIn() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.senderId == request.auth.uid;
      allow update: if signedIn() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid || isAdmin());
      allow delete: if signedIn() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid || isAdmin());
    }

    match /friendships/{friendshipId} {
      allow read: if signedIn() && (resource.data.userIdA == request.auth.uid || resource.data.userIdB == request.auth.uid || isAdmin());
      allow write: if signedIn();
    }

    match /notifications/{notificationId} {
      allow read, update: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if signedIn();
      allow delete: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /conversations/{conversationId} {
      allow read: if signedIn() && (request.auth.uid in resource.data.participantIds || isAdmin());
      allow update: if signedIn() && (
        request.auth.uid in resource.data.participantIds
        || (resource.data.groupId != null && isGroupMember(resource.data.groupId))
        || isAdmin()
      );
      allow create: if signedIn() && request.auth.uid in request.resource.data.participantIds;
      allow delete: if signedIn() && (request.auth.uid in resource.data.participantIds || isAdmin());

      match /participants/{userId} {
        allow read, write: if isUser(userId) || isAdmin();
      }

      match /messages/{messageId} {
        allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow create: if signedIn() && request.resource.data.senderId == request.auth.uid && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow update, delete: if signedIn() && (
          resource.data.senderId == request.auth.uid
          || isAdmin()
          || (
            request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinned', 'highlighted'])
          )
        );
      }
    }

    match /communities/{communityId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if signedIn() && (resource.data.createdBy == request.auth.uid || isAdmin());
    }

    match /community_memberships/{membershipId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if signedIn() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /notes/{noteId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uploadedBy == request.auth.uid;
      allow update, delete: if signedIn() && (resource.data.uploadedBy == request.auth.uid || isAdmin());
    }

    match /projects/{projectId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if signedIn() && (request.auth.uid in resource.data.memberIds || resource.data.createdBy == request.auth.uid || isAdmin());
    }

    match /groups/{groupId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if (
        isGroupAdmin(groupId)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.memberIds.hasAll([resource.data.createdBy])
        && request.resource.data.adminIds.hasAll([resource.data.createdBy])
        && (isGroupCreator(groupId) || request.resource.data.adminIds == resource.data.adminIds)
      ) || (
        signedIn() && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.adminIds == resource.data.adminIds
      );
      allow delete: if isGroupAdmin(groupId) || isAdmin();
    }

    match /group_requests/{requestId} {
      allow read: if signedIn() && (resource.data.receiverId == request.auth.uid || resource.data.senderId == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.senderId == request.auth.uid;
      allow update: if signedIn() && (resource.data.receiverId == request.auth.uid || resource.data.senderId == request.auth.uid || isAdmin());
      allow delete: if signedIn() && (resource.data.receiverId == request.auth.uid || resource.data.senderId == request.auth.uid || isAdmin());
    }

    match /studyGroups/{groupId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if signedIn() && (request.auth.uid in resource.data.memberIds || resource.data.createdBy == request.auth.uid || isAdmin());
    }

    match /support_tickets/{ticketId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /reports/{reportId} {
      allow read: if signedIn() && (resource.data.reporterId == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.reporterId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /mentorRequests/{requestId} {
      allow read: if signedIn() && (resource.data.requesterId == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.requesterId == request.auth.uid;
      allow update: if signedIn() && (resource.data.requesterId == request.auth.uid || isAdmin());
    }

    match /events/{eventId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if signedIn() && (resource.data.createdBy == request.auth.uid || isAdmin());

      match /posts/{postId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if signedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
      }
    }

    match /doubts/{doubtId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if signedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
